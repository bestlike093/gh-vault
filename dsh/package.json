{
  "name": "dsh-gh-vault",
  "version": "1.1.0",
  "description": "在 DeepSeek Harness 里加密保存 GitHub 令牌，让 Agent 代发 GitHub REST API 请求而不接触明文。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "token"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bestlike093/gh-vault"
  }
}
